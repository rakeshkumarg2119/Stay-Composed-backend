# MongoDB
MONGODB_URI=mongodb://localhost:27017
DB_NAME=stay_composed

# SMTP email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Stay Composed - Campus Blood Alert

# Comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# CLIP model used for text and image matching
CLIP_MODEL_NAME=clip-ViT-B-32

# Matching and claim verification
MATCH_MIN_CONFIDENCE=40
CLAIM_MAX_ATTEMPTS=5
CLAIM_COOLDOWN_MINUTES=30
CLAIM_TIMEOUT_HOURS=48

# Chat limits
CHAT_MIN_CONFIDENCE=40
CHAT_MAX_MESSAGES_PER_MINUTE=20
CHAT_MESSAGE_MAX_LENGTH=1000

FIREBASE_CREDENTIALS_PATH=secrets/serviceAccountKey.json
